    "gtm",
    "ga4",
    "meta pixel",
    "facebook pixel",
    "linkedin insight tag",
    "performance",
    "core web vitals",
    "pagespeed",
    "lighthouse",
    "total blocking time",
    "cookie consent",
    "consent mode",
    "google consent mode v2",
    "cookie banner",
    "gdpr",
    "dpdp",
    "ai referrals"
  ],
  "license": "MIT",
  "author": "Codevibe Technology <hello@codevibe.in> (https://codevibe.in)",
  "homepage": "https://codevibe.in/tools/next-deferred-tags?utm_source=npm&utm_medium=package&utm_campaign=next-deferred-tags",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevibe-technology/next-deferred-tags.git"
  },
  "bugs": "https://github.com/codevibe-technology/next-deferred-tags/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "node scripts/readme-utm.mjs npm",
    "postpack": "node scripts/readme-utm.mjs restore"
  },
  "peerDependencies": {
    "next": ">=13.4.0",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
