    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "import": "./dist/pages/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "pages": [
        "./dist/pages/index.d.ts"
      ],
      "adapters": [
        "./dist/adapters/index.d.ts"
      ],
      "server": [
        "./dist/server/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js && tsc -p test/compat/tsconfig.json",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "node scripts/readme-utm.mjs npm",
    "postpack": "node scripts/readme-utm.mjs restore",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "next": ">=13.4.0",
